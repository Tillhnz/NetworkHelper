# Kopiere diese Datei nach .env und passe die Werte an. ./install.sh erledigt das automatisch.

# Beliebiges, langes Passwort für die Datenbank
POSTGRES_PASSWORD=bitte-aendern

# Zufälliger Schlüssel für Login-Tokens, erzeugen z. B. mit: openssl rand -hex 32
SECRET_KEY=bitte-aendern

# Adresse, unter der NetworkHelper erreichbar ist (für Links in Mails und den Installationsbefehl der Agenten)
PUBLIC_URL=http://localhost:8080

# Darf sich jeder registrieren? false = nur du (das erste Konto) und Leute mit Einladungscode
ALLOW_REGISTRATION=false

# Wie viele Proxys stehen vor NetworkHelper? 0 = direkter Zugriff im Heimnetz, 1 = über den Nginx Proxy Manager
TRUSTED_PROXIES=0

# Port im Heimnetz
WEB_PORT=8080

TIMEZONE=Europe/Berlin

# Optional schon hier, sonst unter Administration in der Oberfläche:
# PORKBUN_API_KEY=pk1_…
# PORKBUN_SECRET_KEY=sk1_…
# NPM_URL=http://192.168.1.10:81
# NPM_EMAIL=
# NPM_PASSWORD=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
